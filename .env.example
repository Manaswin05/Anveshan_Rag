# Gemini API Key (Required for RAG embeddings and LLM reasoning)
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Observability & Tracing (Optional)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=Enterprise-Gemini-RAG-Workstation

# Server Port (Optional, default: 5000)
PORT=5000
