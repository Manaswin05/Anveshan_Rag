# Gemini API Key (Required for RAG embeddings and LLM reasoning)
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM Provider Base URLs (Optional - for Ollama, LM Studio, or LocalAI)
# Ollama: Default local inference server (install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio: Local model runtime with OpenAI-compatible API (download from https://lmstudio.ai)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# LocalAI: Self-hosted OpenAI alternative (setup at https://localai.io)
LOCALAI_BASE_URL=http://localhost:8080/v1

# LangSmith Observability & Tracing (Optional)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=Enterprise-Gemini-RAG-Workstation

# Server Port (Optional, default: 5000)
PORT=5000
